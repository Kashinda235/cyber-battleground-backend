### Player profile
GET http://localhost:8000/players/me
Authorization: Bearer {{token}}

### Update system config
PATCH http://localhost:8000/system
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "hostname": "test-machine",
  "password": "new-password",
  "mail": "test-player@example.com"
}

### Get all sysytem db
GET http://localhost:8000/systems
Authorization: Bearer {{token}}

### Get network config
GET http://localhost:8000/system/network
Authorization: Bearer {{token}}

### Update one network port
PATCH http://localhost:8000/system/network/4
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "port": 22,
  "status": "open",
  "metadata": {
    "service": "ssh"
  }
}

### Get defense config
GET http://localhost:8000/system/defense
Authorization: Bearer {{token}}

### Update defense config
PATCH http://localhost:8000/system/defense
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firewall_level": 2,
  "ids_status": true,
  "honeypot_active": false,
  "lockdown_active": true,
  "autopay_threshold": 100
}

### List assets
GET http://localhost:8000/system/assets
Authorization: Bearer {{token}}

### Create asset
POST http://localhost:8000/system/assets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "laptop",
  "value": 50,
  "size": 120,
  "is_decoy": false,
  "is_trap": false
}

### Update asset
PATCH http://localhost:8000/system/assets/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "server-laptop",
  "value": 75
}

### Delete asset
DELETE http://localhost:8000/system/assets/1
Authorization: Bearer {{token}}

### List connections
GET http://localhost:8000/player/connections
Authorization: Bearer {{token}}

### Create connection
POST http://localhost:8000/player/connections
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "target_ip": "192.168.1.20",
  "status": "friend"
}

### Update connection
PATCH http://localhost:8000/player/connections/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "blocked"
}

### Delete connection
DELETE http://localhost:8000/player/connections/1
Authorization: Bearer {{token}}

### Inbox
GET http://localhost:8000/mail/inbox
Authorization: Bearer {{token}}

### Sent
GET http://localhost:8000/mail/sent
Authorization: Bearer {{token}}

### Send mail
POST http://localhost:8000/mail
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "receiver_id": 18,
  "message": "Hello from test",
  "phishing_payload": false,
  "metadata": { "topic": "test" }
}

### Update seen
PATCH http://localhost:8000/mail/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_seen": true
}

### Delete mail
DELETE http://localhost:8000/mail/1
Authorization: Bearer {{token}}
